# The domain of your Snikket instance
SNIKKET_DOMAIN=example.com

# The email address of the primary admin
SNIKKET_ADMIN_EMAIL=admin@example.com

# Confirm you agree to the Let's Encrypt
# terms of service (required). Review the
# document at:
# https://letsencrypt.org/documents/LE-SA-v1.2-November-15-2017.pdf
# If you agree to the terms, change N to Y
SNIKKET_LETSENCRYPT_TOS_AGREE=N

# Compose secrets (RavenGuard, updater) live in .env
# (see .env.example). ./scripts/init.sh writes both files.
# Local quick path: ./scripts/init.sh --dev

# Optional: SHA-256 fingerprint of the Android APK signing certificate.
# Published at /download/android.cert.sha256 and in /download/android.version
# so installs of the self-hosted APK can be verified (e.g. AppVerifier).
# Get it with: apksigner verify --print-certs app-release.apk
# SNIKKET_WEB_ANDROID_CERT_SHA256=

# Optional: SCRAM password storage hash. SHA-256 is stronger but MUST be set
# before the first account exists; enabling it later invalidates all stored
# passwords.
# SNIKKET_TWEAK_PASSWORD_HASH=SHA-256

# Optional: PBKDF2 iteration count for stored passwords (default 10000).
# Higher is harder to brute force but slower on sign-in.
# SNIKKET_TWEAK_ITERATION_COUNT=10000

# Optional: authenticate users against an LDAP directory (org/SSO
# deployments). Accounts come from the directory, so invite-based account
# registration does not apply while this is enabled.
# WARNING: LDAP auth uses a simple bind, so passwords reach Prosody and the
# LDAP server in plaintext. They are only protected by TLS on the wire
# (c2s_require_encryption stays enabled); there is no SCRAM hashing.
# SNIKKET_TWEAK_LDAP=1
# SNIKKET_LDAP_HOST=ldap.example.com
# SNIKKET_LDAP_PORT=389
# SNIKKET_LDAP_USE_TLS=1
# SNIKKET_LDAP_BIND_DN=cn=prosody,dc=example,dc=com
# SNIKKET_LDAP_BIND_PASSWORD=secret
# Or read the bind password from a file instead:
# SNIKKET_LDAP_BIND_PASSWORD_FILE=/run/secrets/ldap_bind_password
# SNIKKET_LDAP_USER_BASE_DN=ou=users,dc=example,dc=com
# SNIKKET_LDAP_USERNAME_FIELD=uid
# SNIKKET_LDAP_NAME_FIELD=cn
# SNIKKET_LDAP_USER_FILTER=(objectClass=inetOrgPerson)
# SNIKKET_LDAP_GROUP_BASE_DN=ou=groups,dc=example,dc=com
# SNIKKET_LDAP_GROUP_MEMBER_FIELD=member

# Optional: allow regular users to create contact invites from their
# client (XEP-0401). Disabled by default because unrestricted invite
# creation can be abused to mass-invite contacts; combine with the daily
# quota below when enabling.
# SNIKKET_TWEAK_CONTACT_INVITES=1

# Optional: allow regular users to create invites that can register new
# accounts on this server. Disabled by default: every such invite can
# create a real account, so only enable if users may onboard others.
# SNIKKET_TWEAK_USER_INVITES=1

# Optional: maximum contact invites a single user may create per UTC day
# (default 20). Admin users are exempt. Limits abuse of in-app invites.
# SNIKKET_TWEAK_CONTACT_INVITES_PER_DAY=20

# Optional: virtual bot identities (mod_snikketx_bots). Bots live at
# name@bots.DOMAIN, join chats and groups, and are driven through a JSON
# API, webhooks, SSE or WebSocket. Users manage their own bots from the
# web portal (Bots page).
# The admin token must be a long random secret shared by the server and
# the web portal. Generate one with: openssl rand -hex 32
# WARNING: a static admin token can manage every bot. Keep it secret,
# rotate it regularly and never commit it to git.
# SNIKKET_TWEAK_BOTS=1
# SNIKKET_TWEAK_BOTS_ADMIN_TOKEN=change-me-long-random
# SNIKKET_WEB_BOTS_ADMIN_TOKEN=change-me-long-random

# Optional: single sign-on for the web portal (OIDC, for example
# PocketID). Sign-in users get an XMPP account provisioned on first
# login; issuer and redirect URL must be https.
# SNIKKET_WEB_OIDC_ISSUER=https://id.example.com
# SNIKKET_WEB_OIDC_CLIENT_ID=snikket-portal
# SNIKKET_WEB_OIDC_CLIENT_SECRET=change-me
# SNIKKET_WEB_OIDC_REDIRECT_URL=https://chat.example.com/auth/oidc/callback
# SNIKKET_WEB_OIDC_USERNAME_CLAIM=preferred_username
# SNIKKET_WEB_OIDC_SCOPES="openid profile email"

# Required for OIDC account provisioning and app bootstrap: a dedicated
# Prosody account with the prosody:admin role. Create it with
#   prosodyctl adduser portal-service@DOMAIN
# and grant the role by adding the account to the server admins list or
# via prosodyctl shell: roles.grant("portal-service@DOMAIN", "prosody:admin").
# SNIKKET_WEB_SERVICE_ADDRESS=portal-service@DOMAIN
# SNIKKET_WEB_SERVICE_PASSWORD=change-me

# Optional: XMPP-level OAuth login (XEP-0493) so OAuth capable clients
# like Badinage can sign in with the same identity provider instead of a
# password. Adds SASL OAUTHBEARER on top of the existing password auth;
# tokens are validated against the IdP userinfo endpoint and mapped to
# localparts through SNIKKET_OAUTH_USERNAME_FIELD.
# SNIKKET_TWEAK_OAUTH=1
# SNIKKET_OAUTH_DISCOVERY_URL=https://id.example.com/.well-known/openid-configuration
# SNIKKET_OAUTH_VALIDATION_ENDPOINT=https://id.example.com/api/oidc/userinfo
# SNIKKET_OAUTH_USERNAME_FIELD=preferred_username
# SNIKKET_OAUTH_SCOPE="openid profile"

# Optional: server-side link previews for the Android app. The portal
# fetches OpenGraph metadata through an authenticated, SSRF hardened
# proxy instead of letting every client contact third-party sites.
# Enabled by default; set to 0 to disable.
# SNIKKET_WEB_LINK_PREVIEW=1
