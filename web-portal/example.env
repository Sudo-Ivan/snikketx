# REQUIRED SETTINGS
# =================

# Secret key used to guard forms and sessions (min 32 bytes).
# If unset, a key is created at SNIKKET_WEB_SECRET_KEY_FILE
# (default /var/lib/snikket-web-portal/secret_key).
SNIKKET_WEB_SECRET_KEY=

# Portal state directory (audit log, oauth_client.json, secret_key).
#SNIKKET_WEB_STATE_DIR=/var/lib/snikket-web-portal

# URL of the Prosody HTTP server (trailing slash optional).
SNIKKET_WEB_PROSODY_ENDPOINT='http://localhost:5280'

# Domain name of the SnikketX server (forced as Host to Prosody).
SNIKKET_WEB_DOMAIN='localhost'

# Human-friendly site name. Defaults to SNIKKET_WEB_DOMAIN.
#SNIKKET_WEB_SITE_NAME=


# OPTIONAL SETTINGS
# =================

#SNIKKET_WEB_AVATAR_CACHE_TTL=1800
#SNIKKET_WEB_MAX_AVATAR_SIZE=1048576
#SNIKKET_WEB_SHOW_METRICS=true
#SNIKKET_WEB_APPLE_STORE_URL=
# Host an Android APK on this portal (also controllable under Admin → Apps).
#SNIKKET_WEB_ANDROID_HOST_ENABLED=false
#SNIKKET_WEB_ANDROID_APK_SOURCE=https://example.com/snikketx.apk
#SNIKKET_WEB_ANDROID_APK_SOURCE=github:YourOrg/snikketx-android
#SNIKKET_WEB_ANDROID_PACKAGE=org.snikket.android
#SNIKKET_WEB_PLAY_STORE_URL=
#SNIKKET_WEB_FDROID_URL=
#SNIKKET_WEB_ANDROID_DOWNLOAD_LIMIT=6
#SNIKKET_WEB_ANDROID_REFRESH_HOURS=12
#SNIKKET_WEB_TOS_URI=
#SNIKKET_WEB_PRIVACY_URI=
#SNIKKET_WEB_ABUSE_EMAIL=
#SNIKKET_WEB_SECURITY_EMAIL=
#SNIKKET_WEB_SECRET_KEY_FILE=/var/lib/snikket-web-portal/secret_key
#SNIKKET_WEB_METRICS_TOKEN=
# When ShowMetrics is true, /metrics stays closed until this Bearer token is set.
#SNIKKET_WEB_INSECURE_COOKIES=false
#SNIKKET_WEB_LOG_LEVEL=info
# Link preview proxy used by the Android app (Basic auth, SSRF hardened,
# 60 requests per account per hour). Set 0 to disable /api/link-preview.
#SNIKKET_WEB_LINK_PREVIEW=true

# Image tag for the ghcr.io/sudo-ivan/snikketx/* images.
# ./scripts/set-channel.sh updates this value (latest, dev, stable).
#SNIKKETX_IMAGE_TAG=latest

# Updater service. Defaults to snikket_updater on the compose network with
# GHCR images under ghcr.io/sudo-ivan/snikketx and Cosign keyless verify.
# ./scripts/init.sh writes random tokens; the literals below are fallbacks.
#SNIKKET_WEB_UPDATER_ENDPOINT=http://snikket_updater:9191
#SNIKKET_WEB_UPDATER_TOKEN=snikket-updater-local
#SNIKKET_UPDATER_TOKEN=snikket-updater-local
#SNIKKET_UPDATER_IMAGE_PREFIX=ghcr.io/sudo-ivan/snikketx
#SNIKKET_UPDATER_VERIFY_SIGNATURES=true
# Prod default is true; dev compose sets false so unsigned :dev tags apply.
#SNIKKET_UPDATER_REQUIRE_SIGNATURES=true

# Backup service. Defaults to snikket_backup on the compose network.
# ./scripts/init.sh writes a random token; the literals below are fallbacks.
#SNIKKET_WEB_BACKUP_ENDPOINT=http://snikket_backup:9292
#SNIKKET_WEB_BACKUP_TOKEN=snikket-backup-local
#SNIKKET_BACKUP_TOKEN=snikket-backup-local
# Optional Restic offsite (passed through compose to snikket_backup).
#RESTIC_REPOSITORY=s3:s3.amazonaws.com/bucket/snikketx
#RESTIC_PASSWORD=
#AWS_ACCESS_KEY_ID=
#AWS_SECRET_ACCESS_KEY=

# Listen address (compose defaults)
#SNIKKET_TWEAK_PORTAL_INTERNAL_HTTP_INTERFACE=0.0.0.0
#SNIKKET_TWEAK_PORTAL_INTERNAL_HTTP_PORT=5765
