# Compose secrets (written by ./scripts/init.sh).
# Copy to .env or let init generate it. Do not commit real secrets.

SNIKKET_DOMAIN=example.com
SNIKKET_ADMIN_EMAIL=admin@example.com

# Image tag for the ghcr.io/sudo-ivan/snikketx/* images.
# ./scripts/set-channel.sh updates this value (latest, dev, stable).
SNIKKETX_IMAGE_TAG=latest

# Shared with snikket_updater and the portal Updates page.
# ./scripts/init.sh writes a random token here. The literal below is the
# built-in fallback used when .env does not set one.
SNIKKET_UPDATER_TOKEN=snikket-updater-local

# Shared with snikket_backup and the portal Backup page.
# ./scripts/init.sh writes a random token here. The literal below is the
# built-in fallback used when .env does not set one.
SNIKKET_BACKUP_TOKEN=snikket-backup-local

# Optional: Cloudflare API token for DNS-01 certificates and DNS record
# management. Needs Zone:Read and DNS:Edit on your zone only.
# Written by ./scripts/enable-dns-acme.sh, or set it here by hand and copy
# deploy/acme-dns/docker-compose.acme-dns.yml.example to
# deploy/acme-dns/docker-compose.acme-dns.yml to activate DNS-01.
# CF_DNS_API_TOKEN=

# Optional: UDP relay port range for TURN (calls). Must be open on the
# host firewall. Both bounds are published and passed to coturn.
# SNIKKET_TURN_MIN_PORT=49152
# SNIKKET_TURN_MAX_PORT=49251

# Optional overrides
# SNIKKET_WEB_UPDATER_ENDPOINT=http://snikket_updater:9191
# SNIKKET_UPDATER_IMAGE_PREFIX=ghcr.io/sudo-ivan/snikketx
# SNIKKET_UPDATER_VERIFY_SIGNATURES=true
# Production default requires Cosign signatures before apply.
# SNIKKET_UPDATER_REQUIRE_SIGNATURES=true
# SNIKKET_WEB_BACKUP_ENDPOINT=http://snikket_backup:9292
# RESTIC_REPOSITORY=s3:s3.amazonaws.com/bucket/snikketx
# RESTIC_PASSWORD=replace-with-restic-password
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Optional: bot management token shared by the server (bot_admin_tokens)
# and the web portal. Enable with SNIKKET_TWEAK_BOTS=1 in snikket.conf.
# SNIKKET_WEB_BOTS_ADMIN_TOKEN=
# SNIKKET_TWEAK_BOTS_ADMIN_TOKEN=

# Optional: portal single sign-on (OIDC).
# SNIKKET_WEB_OIDC_ISSUER=
# SNIKKET_WEB_OIDC_CLIENT_ID=
# SNIKKET_WEB_OIDC_CLIENT_SECRET=
# SNIKKET_WEB_OIDC_REDIRECT_URL=
# SNIKKET_WEB_SERVICE_ADDRESS=
# SNIKKET_WEB_SERVICE_PASSWORD=
