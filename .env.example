# Compose / RavenGuard secrets (written by ./scripts/init.sh).
# Copy to .env or let init generate it. Do not commit real secrets.

SNIKKET_DOMAIN=example.com
SNIKKET_ADMIN_EMAIL=admin@example.com

# RavenGuard admin API and challenge material (min 16 chars for challenge secret).
RG_CHALLENGE_SECRET=replace-with-random-secret
RG_ADMIN_BOOTSTRAP_PASSWORD=replace-with-random-password

# Image tag for the ghcr.io/sudo-ivan/snikketx/* images.
# ./scripts/set-channel.sh updates this value (latest, dev, stable).
SNIKKETX_IMAGE_TAG=latest

# Shared with snikket_updater and the portal Updates page.
# ./scripts/init.sh writes a random token here; the literal below is the
# built-in fallback used when .env does not set one.
SNIKKET_UPDATER_TOKEN=snikket-updater-local

# Shared with snikket_backup and the portal Backup page.
# ./scripts/init.sh writes a random token here; the literal below is the
# built-in fallback used when .env does not set one.
SNIKKET_BACKUP_TOKEN=snikket-backup-local

# Optional overrides
# SNIKKET_WEB_UPDATER_ENDPOINT=http://snikket_updater:9191
# SNIKKET_UPDATER_IMAGE_PREFIX=ghcr.io/sudo-ivan/snikketx
# SNIKKET_UPDATER_VERIFY_SIGNATURES=true
# Production default requires Cosign signatures before apply.
# SNIKKET_UPDATER_REQUIRE_SIGNATURES=true
# SNIKKET_WEB_BACKUP_ENDPOINT=http://snikket_backup:9292
# RESTIC_REPOSITORY=s3:s3.amazonaws.com/bucket/snikketx
# RESTIC_PASSWORD=replace-with-restic-password
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
