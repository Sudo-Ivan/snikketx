# Optional override generated by scripts/migrate-from-snikket.sh.
# Placeholder keeps the path documented. A real migrate run writes either an
# external named-volume binding:
#
# volumes:
#   snikket_data:
#     external: true
#     name: <classic_project>_snikket_data
#
# or, when the classic install bind-mounted /snikket:
#
# volumes:
#   snikket_data:
#     driver: local
#     driver_opts:
#       type: none
#       o: bind
#       device: "/host/path/to/snikket-data"
volumes: {}
